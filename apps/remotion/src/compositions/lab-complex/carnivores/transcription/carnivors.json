1, 1470, 45566, 3762, 6131, 8583, 20681, 5525, 1662, 16991, 9938, 51682], "temperature": 0.0, "avg_logprob": -0.05807728237575955, "compression_ratio": 1.8969072164948453, "no_speech_prob": 0.10288222879171371}, {"id": 28, "seek": 11372, "start": 113.72, "end": 118.72, "text": " А що ж за зло з'явилося 3,5 мільярди років назад?", "tokens": [50365, 3450, 14309, 2989, 4396, 1423, 4610, 1423, 6, 12998, 22201, 1679, 805, 11, 20, 1084, 16651, 681, 481, 14016, 31833, 9718, 28724, 30, 50615], "temperature": 0.0, "avg_logprob": -0.08212378487658145, "compression_ratio": 1.7836879432624113, "no_speech_prob": 0.04069914296269417}, {"id": 29, "seek": 11372, "start": 119.56, "end": 122.08, "text": " Ааа, тут з'являється хижатство", "tokens": [50657, 3450, 386, 386, 11, 12848, 1423, 6, 12998, 2873, 8403, 14706, 3490, 15270, 2134, 9631, 50783], "temperature": 0.0, "avg_logprob": -0.08212378487658145, "compression_ratio": 1.7836879432624113, "no_speech_prob": 0.04069914296269417}, {"id": 30, "seek": 11372, "start": 122.08, "end": 125.08, "text": " Так, хижатство – це перше зло", "tokens": [50783, 8770, 11, 3490, 15270, 2134, 9631, 1662, 18404, 4321, 5246, 1423, 4610, 50933], "temperature": 0.0, "avg_logprob": -0.08212378487658145, "compression_ratio": 1.7836879432624113, "no_speech_prob": 0.04069914296269417}, {"id": 31, "seek": 11372, "start": 125.08, "end": 130.56, "text": " Це момент, коли одні організми вигадують, як позбавляти інших організмів життя", "tokens": [50933, 36263, 17825, 11, 49672, 5693, 10793, 24443, 1416, 28933, 6293, 740, 11294, 2601, 3924, 1283, 11, 14760, 12188, 1552, 1828, 2873, 3396, 29858, 29024, 24443, 1416, 28933, 919, 9718, 2989, 1635, 35151, 51207], "temperature": 0.0, "avg_logprob": -0.08212378487658145, "compression_ratio": 1.7836879432624113, "no_speech_prob": 0.04069914296269417}, {"id": 32, "seek": 11372, "start": 130.56, "end": 132.68, "text": " Зради власної вигоди", "tokens": [51207, 5841, 481, 18389, 740, 23511, 1234, 8045, 740, 11294, 1435, 435, 51313], "temperature": 0.0, "avg_logprob": -0.08212378487658145, "compression_ratio": 1.7836879432624113, "no_speech_prob": 0.04069914296269417}, {"id": 33, "seek": 11372, "start": 132.68, "end": 137.96, "text": " Поки один тихомирно переробляє органічні сполуки або ловить фотони", "tokens": [51313, 2608, 48110, 13319, 1069, 4165, 1253, 4490, 1234, 4321, 1135, 2061, 2873, 8403, 24443, 1416, 33702, 10793, 5307, 1227, 43188, 2559, 18670, 2344, 1055, 3258, 35896, 21869, 51577], "temperature": 0.0, "avg_logprob": -0.08212378487658145, "compression_ratio": 1.7836879432624113, "no_speech_prob": 0.04069914296269417}, {"id": 34, "seek": 13796, "start": 137.96, "end": 144.54000000000002, "text": " Інший намагається відібрати ті капітальні ресурси, якими ведеться це первинне виробництво.", "tokens": [50365, 23297, 489, 24958, 11401, 5583, 19408, 14706, 16947, 42732, 481, 9585, 1069, 1827, 31507, 24947, 3842, 10793, 39836, 7489, 461, 435, 11, 14760, 11426, 35126, 9108, 1679, 18404, 11922, 2599, 4677, 740, 4490, 2061, 36787, 403, 12707, 13, 50694], "temperature": 0.0, "avg_logprob": -0.07035604436346825, "compression_ratio": 1.8410596026490067, "no_speech_prob": 0.0011501733679324389}, {"id": 35, "seek": 13796, "start": 146.14000000000001, "end": 148.70000000000002, "text": " Але ж чому виникає і закріплюється хижатство?", "tokens": [50774, 45043, 2989, 1358, 4161, 28570, 19411, 8403, 8934, 10264, 481, 1827, 1354, 6578, 8403, 14706, 3490, 15270, 2134, 9631, 30, 50902], "temperature": 0.0, "avg_logprob": -0.07035604436346825, "compression_ratio": 1.8410596026490067, "no_speech_prob": 0.0011501733679324389}, {"id": 36, "seek": 13796, "start": 149.64000000000001, "end": 152.22, "text": " Просто, бо воно може бути вигідним.", "tokens": [50949, 34751, 11, 20462, 740, 1784, 354, 4710, 387, 21646, 3396, 740, 11294, 9554, 8444, 13, 51078], "temperature": 0.0, "avg_logprob": -0.07035604436346825, "compression_ratio": 1.8410596026490067, "no_speech_prob": 0.0011501733679324389}, {"id": 37, "seek": 13796, "start": 152.70000000000002, "end": 156.5, "text": " Адже вигода – це розмір надбання мінусу зусильня на здобування.", "tokens": [51102, 3450, 856, 4757, 740, 11294, 22758, 1662, 18404, 20681, 919, 36154, 8469, 1552, 23521, 1084, 17113, 7071, 585, 1423, 7071, 7094, 5151, 1470, 7608, 2061, 9748, 23521, 13, 51292], "temperature": 0.0, "avg_logprob": -0.07035604436346825, "compression_ratio": 1.8410596026490067, "no_speech_prob": 0.0011501733679324389}, {"id": 38, "seek": 13796, "start": 157.24, "end": 161.5, "text": " Якщо акт полювання не вимагає великих зусиль, а винагорода значна,", "tokens": [51329, 46116, 32709, 13790, 403, 4692, 1148, 859, 23521, 1725, 740, 2165, 5583, 19408, 740, 8334, 11855, 1423, 7071, 7094, 11, 2559, 49847, 33747, 10004, 386, 27605, 1931, 11, 51542], "temperature": 0.0, "avg_logprob": -0.07035604436346825, "compression_ratio": 1.8410596026490067, "no_speech_prob": 0.0011501733679324389}, {"id": 39, "seek": 16150, "start": 161.5, "end": 168.38, "text": " Як би аморально це не виглядало, але сама природа створила умови для виникнення такої ситуації.", "tokens": [50365, 46116, 47334, 2559, 919, 1717, 10986, 18404, 1725, 740, 11294, 2873, 856, 12441, 11, 46923, 40517, 41640, 22758, 3266, 21087, 10578, 17497, 1055, 435, 5561, 28570, 9715, 489, 25568, 2936, 49065, 27840, 386, 34780, 13, 50709], "temperature": 0.0, "avg_logprob": -0.08369719319873387, "compression_ratio": 1.8593272171253823, "no_speech_prob": 0.0023147626779973507}, {"id": 40, "seek": 16150, "start": 169.04, "end": 176.3, "text": " Наприклад, хижа, сапротрофна кишкова паличка, за сприятливих умов ділиться кожні 20 хвилин.", "tokens": [50742, 36552, 3605, 10396, 11, 3490, 15270, 386, 11, 776, 4219, 481, 7954, 48645, 1931, 981, 9919, 7718, 386, 40415, 3903, 2833, 11, 4396, 5307, 4679, 4558, 15054, 4165, 17497, 1055, 1070, 1827, 1675, 14706, 40107, 10793, 945, 3490, 859, 5435, 489, 13, 51105], "temperature": 0.0, "avg_logprob": -0.08369719319873387, "compression_ratio": 1.8593272171253823, "no_speech_prob": 0.0023147626779973507}, {"id": 41, "seek": 16150, "start": 176.78, "end": 183.04, "text": " А мирна автотрофна цяна бактерія витрачає на поділ від 8 до 24 годин.", "tokens": [51129, 3450, 20536, 1931, 14376, 860, 403, 9938, 3619, 1931, 5188, 681, 1931, 1268, 38659, 34299, 740, 1635, 29983, 19408, 1470, 4095, 35432, 16947, 1649, 5865, 4022, 9182, 2599, 13, 51442], "temperature": 0.0, "avg_logprob": -0.08369719319873387, "compression_ratio": 1.8593272171253823, "no_speech_prob": 0.0023147626779973507}, {"id": 42, "seek": 16150, "start": 184.3, "end": 188.26, "text": " Оскільки мирний будівельник робить все самостійно, а хижак отримує все готове.", "tokens": [51505, 3688, 4218, 45642, 20536, 15199, 4529, 9718, 3908, 9715, 30971, 3258, 4640, 5602, 16543, 16471, 1234, 11, 2559, 3490, 15270, 1272, 2943, 42200, 36382, 4640, 17137, 387, 13, 51703], "temperature": 0.0, "avg_logprob": -0.08369719319873387, "compression_ratio": 1.8593272171253823, "no_speech_prob": 0.0023147626779973507}, {"id": 43, "seek": 18826, "start": 188.26, "end": 202.85999999999999, "text": " Якщо розколупавши оленя, родина пітекандропа може жити три місяці без голоду і втоми, створюється дуже значний стимул зайнятися саме полюванням, а не пошуком малопоживних коренців і рідкісних ягід.", "tokens": [50365, 46116, 32709, 20681, 24899, 6907, 1828, 1198, 435, 1000, 11586, 681, 11, 17925, 7861, 713, 24947, 2872, 12551, 26090, 386, 4710, 387, 2989, 18686, 22068, 23895, 1679, 12857, 10969, 14932, 35749, 8934, 740, 17804, 435, 11, 3266, 21087, 1148, 8403, 14706, 39919, 27605, 15199, 3266, 2165, 23412, 40133, 5151, 3396, 1679, 5602, 387, 4692, 1148, 859, 23521, 919, 11, 2559, 1725, 27148, 10282, 1253, 19499, 3762, 2161, 2739, 21070, 11384, 1008, 1814, 9718, 8934, 1475, 9554, 755, 32738, 21070, 2552, 1906, 9554, 13, 51095], "temperature": 0.0, "avg_logprob": -0.07418503376267711, "compression_ratio": 1.9255014326647564, "no_speech_prob": 0.3740244209766388}, {"id": 44, "seek": 18826, "start": 203.88, "end": 217.01999999999998, "text": " Але не дивлячись на виникнення хижого способу життя, мирний спосіб не зникає, не зникає й симбіоз. Ба більше, ми спостерігаємо трансформацію хижаків в мирняків із часом.", "tokens": [51146, 45043, 1725, 49829, 2873, 753, 10363, 1470, 28570, 9715, 489, 25568, 3490, 15270, 2350, 23677, 585, 2989, 1635, 35151, 11, 20536, 15199, 5307, 1885, 42732, 1725, 1423, 19411, 8403, 11, 1725, 1423, 19411, 8403, 24540, 38994, 1552, 1827, 3434, 13, 5697, 386, 47692, 5246, 11, 13803, 5307, 16543, 1135, 1827, 18706, 8403, 20455, 7550, 15720, 18190, 386, 12857, 1148, 3490, 15270, 1272, 9718, 740, 20536, 5151, 755, 9718, 49973, 13562, 1253, 13, 51803], "temperature": 0.0, "avg_logprob": -0.07418503376267711, "compression_ratio": 1.9255014326647564, "no_speech_prob": 0.3740244209766388}, {"id": 45, "seek": 21702, "start": 217.02, "end": 222.06, "text": " Більшість принципово нових видів формуються як хижакі на вже існуючі.", "tokens": [50365, 5697, 16651, 1198, 1827, 3167, 30147, 1055, 354, 10022, 4165, 6504, 9718, 22817, 3924, 14706, 14760, 3490, 15270, 1272, 1827, 1470, 40738, 8934, 461, 9882, 753, 1827, 13, 50617], "temperature": 0.0, "avg_logprob": -0.09369155175671606, "compression_ratio": 2.0516717325227964, "no_speech_prob": 0.03504101559519768}, {"id": 46, "seek": 21702, "start": 222.76000000000002, "end": 227.5, "text": " Еукаріоти полюють на прокаріот, багатоклітинні організми полюють на одноклітинні.", "tokens": [50652, 6538, 10282, 2222, 1827, 1631, 435, 4692, 1148, 47469, 1470, 37225, 2222, 1827, 1631, 11, 45165, 2134, 2637, 693, 24947, 2599, 10793, 24443, 1416, 28933, 6293, 4692, 1148, 47469, 1470, 5693, 48717, 693, 24947, 2599, 10793, 13, 50889], "temperature": 0.0, "avg_logprob": -0.09369155175671606, "compression_ratio": 2.0516717325227964, "no_speech_prob": 0.03504101559519768}, {"id": 47, "seek": 21702, "start": 228.26000000000002, "end": 230.9, "text": " Перші земноводні хапають риб і безхребетних.", "tokens": [50927, 2608, 19465, 1827, 27230, 8766, 1435, 10793, 3490, 4219, 40381, 1475, 9772, 8934, 10969, 1157, 481, 3749, 1094, 21070, 13, 51059], "temperature": 0.0, "avg_logprob": -0.09369155175671606, "compression_ratio": 2.0516717325227964, "no_speech_prob": 0.03504101559519768}, {"id": 48, "seek": 21702, "start": 231.54000000000002, "end": 235.12, "text": " Плазуни із савці починають як мисливці на комах.", "tokens": [51091, 2608, 693, 1990, 585, 1903, 49973, 776, 1828, 12857, 12079, 7861, 47469, 14760, 1084, 3323, 15054, 12857, 1470, 7761, 7004, 13, 51270], "temperature": 0.0, "avg_logprob": -0.09369155175671606, "compression_ratio": 2.0516717325227964, "no_speech_prob": 0.03504101559519768}, {"id": 49, "seek": 21702, "start": 236.76000000000002, "end": 245.10000000000002, "text": " Але з часом перші мисливці породжують більш поміркованих в своїй агресії нащадків, які починають харчуватися рослинами.", "tokens": [51352, 45043, 1423, 13562, 1253, 4321, 1198, 1827, 1084, 3323, 15054, 12857, 11948, 1435, 1820, 3924, 1283, 47692, 1198, 8613, 36154, 7718, 3733, 1157, 740, 6989, 8045, 1644, 2559, 7786, 2292, 29536, 1470, 2000, 2601, 755, 9718, 11, 35110, 12079, 7861, 47469, 38795, 753, 36303, 1679, 44935, 25958, 5150, 13, 51769], "temperature": 0.0, "avg_logprob": -0.09369155175671606, "compression_ratio": 2.0516717325227964, "no_speech_prob": 0.03504101559519768}, {"id": 50, "seek": 24510, "start": 245.1, "end": 264.18, "text": " А деякі можуть навіть отримувати енергію з сонця. Щоправда, не напряму, а через симбіоз з виростями. Чимож все не вимирає із появою хижатства? Або всі не стають хижаками? Прибитковість хижатства величина не постійна.", "tokens": [50365, 3450, 36397, 681, 43649, 4710, 13967, 14192, 49852, 2943, 42200, 36303, 1997, 489, 19480, 1827, 1148, 1423, 776, 1784, 1814, 681, 13, 42373, 3762, 5608, 3444, 11, 1725, 18296, 10531, 585, 11, 2559, 17341, 38994, 1552, 1827, 3434, 1423, 740, 4490, 16543, 31215, 13, 7099, 2165, 2161, 4640, 1725, 740, 1